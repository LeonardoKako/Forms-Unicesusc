# ==========================================
# 2. FLUXO JWT: VERIFICAÇÃO DE EMAIL
# ==========================================

### 2.1 Verificar Email do Autor (Etapa 1)
# Cole o token recebido no email de verificação
# Este link também aparece no email enviado ao requesterEmail
GET {{baseUrl}}/events/verify-author?token=COLAR_TOKEN_DO_EMAIL_AQUI

### 2.2 Admin Visualiza o Evento (Etapa 2)
# Cole o token recebido no email de aprovação (enviado a formulario.eventos@unicesusc.edu.br)
GET {{baseUrl}}/events/admin-review?token=COLAR_TOKEN_ADMIN_AQUI

