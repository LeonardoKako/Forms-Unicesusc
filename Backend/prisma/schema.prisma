// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model EventTicket {
  id                    String   @id @default(uuid())
  controlCode           String   @unique // Ex: #482910
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  // 👤 Dados do Solicitante
  requesterName         String
  requesterEmail        String
  requesterPhone        String
  requesterType         String   // "interno" ou "locacao"
  requesterDepartment   String?  // Opcional: Setor/Curso (Apenas para Interno)
  adminApprovalFileUrl  String?  // Opcional: URL da confirmação do administrativo (Locação)
  
  // 🤝 Detalhes do Evento Parceiro (Opcionais, se for evento parceiro)
  isPartnerEvent        Boolean  @default(false)
  partnerName           String?
  partnerEmail          String?
  partnerPhone          String?
  partnerInstitution    String?
  
  // 📝 Detalhes Gerais do Evento
  eventTitle            String
  eventType             String
  eventDescription      String   @db.Text
  targetAudience        String[] // Array de públicos (PostgreSQL)
  estimatedPublic       Int
  
  // 📅 Data, Local & Orçamento
  eventDate             DateTime // Data do evento
  startTime             String   // "12:32"
  endTime               String   // "15:32"
  selectedRoom          String   // Ex: "auditorio"
  needsBudget           Boolean  @default(false)
  budgetApprovalFileUrl String?  // URL da confirmação da Reitoria (se necessitar de orçamento)
  
  // 🍽️ Alimentação e Utensílios
  copa                  String[] // Array de itens da copa
  coffeeBreak           String[] // Array de itens de coffee break
  
  // 🛠️ Logística, T.I. & Apoio
  tiEquipment           String[] // Array de equipamentos solicitados
  furnitureSupport      String[] // Array de móveis de apoio
  supportTeams          SupportTeam[]            @relation("EventBookingsSupportTeams")
  presentationMaterials String[] // Array de tipos de materiais de apresentação
  presentationDriveLink String?  // URL do Google Drive contendo materiais de apresentação
  needsArtwork          Boolean  @default(false)
  artworkDescription    String?  @db.Text // Descrição da arte marketing (se necessitar de arte)

  @@map("event_bookings")
}

model SupportTeam {
  id           String        @id
  name         String
  email        String?
  eventTickets EventTicket[] @relation("EventBookingsSupportTeams")

  @@map("support_teams")
}
