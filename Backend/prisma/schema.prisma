// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Event {
  id                    String   @id @default(uuid())
  controlCode           String   @unique // Ex: #INT-482910
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  authorVerification    String   @default("pending") // pending | approved
  adminVerification     String   @default("pending") // pending | approved | rejected
  adminRejectionReason  String?  @db.Text
  
  // 👤 Dados do Solicitante
  requesterName         String
  requesterEmail        String
  requesterPhone        String
  requesterType         String   // "interno"
  requesterDepartment   String   // Setor/Coordenação
  
  // 🤝 Detalhes do Evento Parceiro
  isPartnerEvent        Boolean  @default(false)
  partnerName           String?
  partnerEmail          String?
  partnerPhone          String?
  partnerInstitution    String?
  
  // 📝 Detalhes Gerais do Evento
  eventTitle            String
  eventType             String
  eventDescription      String   @db.Text
  targetAudience        String[] // Array de públicos
  estimatedPublic       Int
  
  // 📅 Data, Local & Orçamento
  eventDate             DateTime // Data do evento
  startTime             String   // "12:32"
  endTime               String   // "15:32"
  selectedRoom          String   // Ex: "auditorio"
  roomNotes             String?  @db.Text
  needsBudget           Boolean  @default(false)
  budgetApprovalFileUrl String?  // URL da confirmação (Supabase Storage)
  
  // 🍽️ Alimentação e Utensílios
  copa                  String[] // Array de itens da copa
  otherCopaDescription  String?  @db.Text
  coffeeBreak           String   // Nome do plano de coffee ou "nao_se_aplica"
  coffeeNotes           String?  @db.Text
  
  // 🛠️ Logística, T.I. & Apoio
  tiEquipment           String[] // Array de equipamentos solicitados
  furnitureSupport      String[] // Array de móveis de apoio
  otherFurnitureDescription String? @db.Text
  supportTeams          SupportTeam[] @relation("EventsSupportTeams")
  presentationMaterials String[] // Array de tipos de materiais de apresentação
  presentationDriveLink String?  // URL do Google Drive
  needsArtwork          Boolean  @default(false)
  hasPrintedArtwork     Boolean? // Peça impressa exige orçamento
  artworkDescription    String?  @db.Text // Descrição da arte

  @@map("events")
}

model Location {
  id                    String   @id @default(uuid())
  controlCode           String   @unique // Ex: #LOC-918523
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  // 👤 Dados do Solicitante
  requesterName         String
  requesterEmail        String
  requesterPhone        String
  requesterType         String   // "locacao"
  
  // 📅 Data, Local & Orçamento
  eventDate             DateTime // Data do evento
  startTime             String   // "07:30"
  endTime               String   // "22:30"
  selectedRoom          String   // Ex: "colegio"
  roomNotes             String?  @db.Text
  
  // 🛠️ Logística & Apoio
  supportTeams          SupportTeam[] @relation("LocationsSupportTeams")

  @@map("locations")
}

model SupportTeam {
  id           String        @id
  name         String
  email        String?
  events       Event[]       @relation("EventsSupportTeams")
  locations    Location[]    @relation("LocationsSupportTeams")

  @@map("support_teams")
}
