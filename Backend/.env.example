# URL de conexão com o banco de dados PostgreSQL
# Substitua usuario, senha, host, porta e nome_do_banco pelas credenciais corretas
DATABASE_URL="postgresql://usuario:senha@localhost:5432/nome_do_banco?schema=public"

# Porta onde o servidor NestJS irá rodar
PORT=3000
# --- Banco de Dados PostgreSQL ---
DB_USER=postgres
DB_PASSWORD=unicesusc_db_password
DB_NAME=forms_unicesusc
DB_PORT=5432

# --- Segurança e Rotas ---
JWT_SECRET=sua_chave_jwt_secreta_aqui
FRONTEND_URL=http://localhost

# --- Configurações SMTP Google Workspace ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=formulario.eventos@unicesusc.edu.br
SMTP_PASS=sua_senha_de_app_aqui
MAIL_FROM=formulario.eventos@unicesusc.edu.br

# --- Destinatários do Fluxo ---
EVENTS_ADMIN_EMAIL=formulario.eventos@unicesusc.edu.br
LOCATIONS_VERIFIER_EMAIL=formulario.eventos@unicesusc.edu.br
LOCATIONS_ADMIN_EMAIL=formulario.eventos@unicesusc.edu.br